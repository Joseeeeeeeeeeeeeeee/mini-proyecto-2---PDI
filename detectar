import numpy as np
import matplotlib.pyplot as plt
from skimage.feature import graycomatrix

alto=ancho=128 #img.shape
bandas=np.tile((np.arange(ancho)//32)%2, (alto,1)).astype('uint8')

y,x=np.indices((alto,ancho))
damero=((x//8 + y//8)%2).astype('uint8')
aleatorio=np.random.default_rng(2).integers(0,2,(alto,ancho),dtype='uint8')

fig, ejes=plt.subplots(2,3, figsize=(12,8))

for i, (nombre, imagen) in enumerate([("Bandas",bandas), ("Damero",damero), ("Aleatorio",aleatorio)]):

    glcm=graycomatrix(imagen, distances=[1], angles=[0], levels=2, symmetric=True, normed=True)
    P=glcm[:,:,0,0]
    ejes[0,i].imshow(imagen, cmap='gray', vmin=0, vmax=1)
    ejes[0,i].set_title(nombre)
    ejes[1,i].imshow(P, cmap='Blues', vmin=0, vmax=1)
    ejes[1,i].set_title('GLCM')

    for ax in (ejes[0,i], ejes[1,i]):
        ax.axis('off')

plt.tight_layout()
plt.show()


