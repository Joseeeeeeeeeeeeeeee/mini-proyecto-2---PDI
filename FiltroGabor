import cv2 as cv
import numpy as np
import matplotlib.pyplot as plt
from skimage import data

# Imagen de muestra incluida en scikit-image: no requiere archivos externos.
imagen = data.camera().astype(np.float32) / 255.0

# getGaborKernel: (tamaño, sigma, theta, lambda, gamma, fase, tipo)
theta = np.deg2rad(45)
nucleo = cv.getGaborKernel((31, 31), 5.0, theta, 10.0, 0.5, 0, ktype=cv.CV_32F)

# Centramos y normalizamos para reducir la respuesta a brillo uniforme.
nucleo -= nucleo.mean()
nucleo /= np.sum(np.abs(nucleo)) + 1e-8

respuesta = cv.filter2D(imagen, cv.CV_32F, nucleo, borderType=cv.BORDER_REFLECT101)

fig, ejes = plt.subplots(1, 3, figsize=(12, 4))
ejes[0].imshow(imagen, cmap="gray", vmin=0, vmax=1)
ejes[0].set_title("Imagen original")
ejes[1].imshow(nucleo, cmap="RdBu_r")
ejes[1].set_title("Núcleo Gabor: 45°")
ejes[2].imshow(respuesta, cmap="gray")
ejes[2].set_title("Respuesta con signo")
for eje in ejes:
    eje.axis("off")
plt.tight_layout()
plt.show()